# ============================================================
# ORBITFS DEV PANEL — PRODUCTION ENVIRONMENT
# Runtime: Vercel production
# ============================================================

# ----------------------------
# Supabase — same project/database as License Manager
# ----------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ----------------------------
# Public panel
# ----------------------------
APP_URL=https://dev.incendiarynetworks.cc

# ----------------------------
# License Master
# ----------------------------
LICENSE_MASTER_URL=https://incendiarynetworks.cc/api
LICENSE_MASTER_API_TOKEN=use-the-stable-license-manager-master-api-token

# ----------------------------
# GitHub Actions control
# Manual release dispatch only — no Vercel auto-deploy
# ----------------------------
ORBITFS_RELEASE_DISPATCH_TOKEN=use-the-stable-github-actions-dispatch-token
GITHUB_API_VERSION=2022-11-28

# ----------------------------
# Future release sources
# Keep these disabled/unconfigured until V1 release repositories are brought back.
# ----------------------------
# BASE_RELEASE_REPO=
# BASE_RELEASE_REF=
# BASE_RELEASE_WORKFLOW=
# ENGINE_RELEASE_REPO=
# ENGINE_RELEASE_REF=
# ENGINE_RELEASE_WORKFLOW=
