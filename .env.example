# ORBITFS DEV PANEL — PRODUCTION ENVIRONMENT
# Secrets are server-only. Do not commit real values.
# License Master is the technical authority; this panel is only release control.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

APP_URL=https://dev.incendiarynetworks.cc

# Managed API key issued/scoped by Custom-licence-manager for this panel.
# This is NOT MASTER_API_TOKEN and must never be the License Master's master key.
LICENSE_MASTER_URL=https://incendiarynetworks.cc/api
LICENSE_MASTER_API_TOKEN=use-the-License-Master-managed-release-control-key

# GitHub PAT used by the panel to dispatch/read the two V1 workflows.
ORBITFS_RELEASE_DISPATCH_TOKEN=use-the-stable-github-actions-write-pat
GITHUB_API_VERSION=2022-11-28

BASE_RELEASE_REPO=lucaskerim123/V1-vercel-base
BASE_RELEASE_REF=base-release
BASE_RELEASE_WORKFLOW=release-to-license-master.yml

ENGINE_RELEASE_REPO=lucaskerim123/V1-vercel-engine
ENGINE_RELEASE_REF=UPDATE_RELEASE
ENGINE_RELEASE_WORKFLOW=publish-engine-release.yml

# The current Engine workflow does not require ORBITFS_ENGINE_RELEASE_PUBLISH_TOKEN.
# It uses LICENSE_MASTER_API_TOKEN for the License Master handoff/validation.
