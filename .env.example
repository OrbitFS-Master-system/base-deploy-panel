# ============================================================
# ORBITFS DEV PANEL — PRODUCTION ENVIRONMENT
# ============================================================
# Runtime: Vercel Production
# Purpose: private operator/developer release control panel
#
# Manual release workflow only.
# This panel must NOT trigger Vercel automatic deployments.
# NEVER commit real secrets to Git.
# ============================================================

# ============================================================
# 01 — SUPABASE
# Same Supabase project/database as License Manager.
# Browser-safe values only.
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ============================================================
# 02 — PANEL URL
# ============================================================
APP_URL=https://dev.incendiarynetworks.cc

# ============================================================
# 03 — LICENSE MASTER CONNECTION
# License Manager remains the technical authority.
# Use the existing stable License Master integration credential.
# Do not generate a new credential when the panel is reconfigured.
# ============================================================
LICENSE_MASTER_URL=https://incendiarynetworks.cc/api
LICENSE_MASTER_API_TOKEN=use-the-stable-license-master-integration-token

# ============================================================
# 04 — GITHUB RELEASE DISPATCH
# Stable GitHub PAT used by Dev Panel to manually dispatch
# the release workflows. Separate from the License Manager API token.
# Required permission: Actions read/write.
# ============================================================
ORBITFS_RELEASE_DISPATCH_TOKEN=use-the-stable-github-actions-write-pat
GITHUB_API_VERSION=2022-11-28

# ============================================================
# 05 — BASE RELEASE SOURCE
# Active V1 release source; do not redesign the V1 repo here.
# ============================================================
BASE_RELEASE_REPO=lucaskerim123/V1-vercel-base
BASE_RELEASE_REF=base-release
BASE_RELEASE_WORKFLOW=release-to-license-master.yml

# ============================================================
# 06 — ENGINE / UPDATE RELEASE SOURCE
# Active V1 release source; do not redesign the V1 repo here.
# ============================================================
ENGINE_RELEASE_REPO=lucaskerim123/V1-vercel-engine
ENGINE_RELEASE_REF=UPDATE_RELEASE
ENGINE_RELEASE_WORKFLOW=publish-engine-release.yml

# ============================================================
# 07 — DEPLOYMENT RULE
# Vercel deployments remain MANUAL.
# This panel dispatches release workflows; it does not deploy Vercel.
# ============================================================
