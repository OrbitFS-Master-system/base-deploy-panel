# ============================================================
# ORBITFS DEV PANEL — PRODUCTION ENVIRONMENT
# ============================================================
# Runtime: Vercel Production
# Purpose: private operator/developer release control panel
#
# Manual release workflow only.
# This panel must NOT trigger Vercel automatic deployments.
# NEVER commit real secrets to Git.
# ============================================================

# ============================================================
# 01 — SUPABASE
# Same Supabase project/database as License Manager.
# Browser-safe values only.
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ============================================================
# 02 — PANEL URL
# ============================================================
APP_URL=https://dev.incendiarynetworks.cc

# ============================================================
# 03 — LICENSE MASTER CONNECTION
# License Manager remains the technical authority.
# Use the same stable MASTER_API_TOKEN credential issued by
# License Manager; do not generate a new credential per panel.
# ============================================================
LICENSE_MASTER_URL=https://incendiarynetworks.cc/api
LICENSE_MASTER_API_TOKEN=use-the-stable-license-manager-master-api-token

# ============================================================
# 04 — GITHUB RELEASE DISPATCH
# Stable credential used by Dev Panel to manually dispatch
# approved release workflows.
# This is separate from the License Manager API token.
# ============================================================
ORBITFS_RELEASE_DISPATCH_TOKEN=use-the-stable-github-release-dispatch-token
GITHUB_API_VERSION=2022-11-28

# ============================================================
# 05 — RELEASE SOURCE CONFIGURATION
# Currently disabled while V1 release repositories are parked.
# Do not populate these until release repositories are brought
# back into the active architecture.
# ============================================================
# BASE_RELEASE_REPO=
# BASE_RELEASE_REF=
# BASE_RELEASE_WORKFLOW=
# ENGINE_RELEASE_REPO=
# ENGINE_RELEASE_REF=
# ENGINE_RELEASE_WORKFLOW=

# ============================================================
# 06 — VERCEL / DEPLOYMENT NOTE
# No VERCEL_TOKEN is required by the Dev Panel runtime.
# Vercel deployment credentials belong to the manual GitHub
# deployment workflow, not to browser/client configuration.
#
# GitHub deployment secret used by deployment workflows:
#   VERCEL_TOKEN
#
# GitHub control credentials are not exposed to the browser.
# ============================================================
